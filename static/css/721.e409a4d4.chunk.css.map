#inputusername,
#inputemail,
#inputState,
#inputpassword,
#inputmobile,
#inputconfirmpassword {
    background: transparent;
    color: wheat;
    border: 1px solid aqua;
}

.regdiv2 a {
    text-decoration: none;
}

.backbtn {
    background-color: transparent;
    color: blue;
    font-weight: lighter;
}

.backbtn:hover {
    color: white;
    font-weight: bold;
}

.registerbody {
    font-family: Arial, sans-serif;
    background: linear-gradient(to left,rgba(91, 228, 125,.4),rgba(245, 137, 164, 0.2),rgba(85, 70, 248,.3));
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0 auto;
    overflow: hidden;
}

.register-container {
    background: url("../../../assets/images/backgroundregisterss.jpg");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    border-radius: 8px;
    width: calc(100vh - 200px);
    box-shadow: 0 4px 8px rgba(29, 28, 28, 0.4);
    overflow: hidden;
}

.register-header {
    background: linear-gradient(to left,rgba(76, 193, 105, 0.4),rgba(219, 105, 143, 0.2),rgba(124, 114, 230, 0.3));
    color: #0d0d0d;
    font-weight: 600;
    padding: 20px;
    text-align: center;
    font-size: 1.5em;
}

.register-form {
    padding: 20px;
    margin: 0 auto;
}

.register-form label {
    width: 100%;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: 1.7px solid rgb(164, 161, 161);
    box-sizing: border-box;
}

.register-form input[type="text"],
.register-form input[type="email"],
.register-form input[type="password"],
.register-form input[type="tel"],
.register-form select {
    width: 85%;
    padding: 10px;
    margin: 0 0;
    border: none;
    box-sizing: border-box;
    outline: none;
}


.checkbox-group {
    display: flex;
    justify-content: space-between;
    margin: 10px 0;
}

.register-button {
    background: #AB183D;
    color: #fff;
    padding: 10px;
    border: none;
    border-radius: 4px;
    width: 100%;
    cursor: pointer;
    font-size: 1em;
}

.register-button:hover {
    background: #e33c66;
}

